{
  "manifest_version": 3,
  "name": "trustscore_ai",
  "version": "1.0",
  "description": "Check website trust score instantly",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "trustscore_ai"
  }
}